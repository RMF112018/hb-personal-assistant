# HB Personal Assistant + Work Product Intelligence System
# Local secrets and environment overrides (NEVER commit this file with real values)
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values (or export in shell / launchd plist)
#
# Primary auth is delegated user (no client secret needed for public client).
# Certificate is for app-only proof/admin flows only (see Phase 0 evidence).

# Microsoft Entra ID / App Registration (from known HB SharePoint Creator registration)
AZURE_TENANT_ID=0e834bd7-628b-42c8-b9ec-ecebc9719be4
AZURE_CLIENT_ID=08c399eb-a394-4087-b859-659d493f8dc7

# Optional: path to certificate bundle for app-only token acquisition (proof only, not runtime default)
# AZURE_CLIENT_CERT_PATH=~/.secrets/hb-sharepoint-creator/hb-sharepoint-creator.bundle.pem

# Optional vault/config overrides (can also be set via config/config.yml or env var HB_PA_*)
# HB_PERSONAL_ASSISTANT_VAULT=/Users/bobbyfetting/Documents/Obsidian Vault
# HB_PERSONAL_ASSISTANT_APP_SUPPORT=~/Library/Application Support/HB Personal Assistant

# Logging / diagnostics
# LOG_LEVEL=INFO

# Security (must remain false for MVP)
MICROSOFT_365_WRITEBACK_ENABLED=false
