      "Hour": 20,
      "Minute": 0
    },
    "WorkingDirectory": "/Users/bobbyfetting/hb-personal-assistant"
  },
  "plist_path": "/Users/bobbyfetting/Library/LaunchAgents/com.hb.personal-assistant.scheduler.production.plist",
  "writes_files": false
}