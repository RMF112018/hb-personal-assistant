{
  "action": "preview",
  "backend": "launchd",
  "dry_run": true,
  "installed": false,
  "plist": {
    "EnvironmentVariables": {
      "PYTHONUNBUFFERED": "1"
    },
    "Label": "com.hb.personal-assistant.scheduler.production",
    "ProgramArguments": [
      "/Users/bobbyfetting/hb-personal-assistant/.venv/bin/hb-assistant",
      "scheduler",
