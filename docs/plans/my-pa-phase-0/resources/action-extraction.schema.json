{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionExtractionResult",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stable_key",
          "action_type",
          "title",
          "confidence",
          "source_record_ids"
        ],
        "properties": {
          "stable_key": {
            "type": "string"
          },
          "action_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_record_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
