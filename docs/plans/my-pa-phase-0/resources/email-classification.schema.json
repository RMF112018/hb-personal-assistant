{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmailClassificationResult",
  "type": "object",
  "required": [
    "message_source_record_id",
    "classifications",
    "body_mention_detected",
    "confidence"
  ],
  "properties": {
    "message_source_record_id": {
      "type": "string"
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "body_mention_detected": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
