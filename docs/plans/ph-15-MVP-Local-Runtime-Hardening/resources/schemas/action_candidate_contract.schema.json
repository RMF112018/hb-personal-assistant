{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HB Assistant Action Candidate Contract",
  "type": "object",
  "required": [
    "stable_key",
    "title",
    "action_type",
    "confidence",
    "status",
    "sources"
  ],
  "properties": {
    "stable_key": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 240
    },
    "action_type": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string"
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
