{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEOS Finding",
  "type": "object",
  "required": [
    "finding_id",
    "severity",
    "status",
    "title",
    "evidence",
    "required_remediation"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "status": {
      "enum": [
        "open",
        "fix_claimed",
        "verified_fixed",
        "deferred_with_accepted_risk",
        "rejected_with_rationale",
        "not_reproducible"
      ]
    },
    "title": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "required_remediation": {
      "type": "string"
    },
    "verification_method": {
      "type": "string"
    }
  }
}