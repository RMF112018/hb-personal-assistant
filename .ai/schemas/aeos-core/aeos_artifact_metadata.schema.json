{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEOS Artifact Metadata",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "status",
    "repository",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_type": {
      "enum": [
        "repository_truth_report",
        "architecture_artifact",
        "adr",
        "implementation_plan",
        "evidence_package",
        "audit_report",
        "corrective_review",
        "go_no_go"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "approved",
        "superseded",
        "rejected",
        "final"
      ]
    },
    "repository": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "base_sha": {
      "type": "string"
    },
    "head_sha": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "related_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}