{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 2 Sync Receipt",
  "type": "object",
  "required": [
    "source_id",
    "mode",
    "started_at",
    "status"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "source_scope": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "dry_run",
        "apply"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "pages_seen": {
      "type": "integer"
    },
    "items_seen": {
      "type": "integer"
    },
    "items_in_scope": {
      "type": "integer"
    },
    "items_out_of_scope_filtered": {
      "type": "integer"
    },
    "delta_link_recorded": {
      "type": "boolean"
    },
    "raw_delta_link_redacted": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
