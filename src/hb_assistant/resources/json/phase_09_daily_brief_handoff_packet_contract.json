{
  "contract_name": "daily_brief_handoff_packet_contract",
  "version": "1.0.0-phase-09-addendum",
  "packet_version": "DailyBriefHandoffPacketV1",
  "description": "Stable, metadata-only daily-brief handoff packet that Claude consumes through MCP for rendering only. No retrieval logic is duplicated in MCP; the packet is a read-only projection of the existing daily-brief context. No raw content, no writeback, no final determinations.",
  "required_packet_fields": [
    "packet_id",
    "packet_version",
    "generated_utc",
    "brief_date",
    "project_scope",
    "mode",
    "source_coverage_summary",
    "what_matters_today",
    "recent_changes",
    "review_required_items",
    "aging_watchlist",
    "meeting_prep",
    "risk_watchlist",
    "stale_or_low_confidence_warnings",
    "accepted_memory_context",
    "suggested_follow_up_questions",
    "source_refs",
    "guardrails",
    "rendering_instructions"
  ],
  "item_sections": [
    "recent_changes",
    "review_required_items",
    "aging_watchlist",
    "meeting_prep",
    "risk_watchlist",
    "stale_or_low_confidence_warnings",
    "accepted_memory_context"
  ],
  "item_fields": [
    "item_id",
    "section",
    "priority",
    "project_key",
    "title_redacted",
    "summary_redacted",
    "source_family",
    "source_ref_hash",
    "source_ref_label",
    "review_tier",
    "review_required",
    "confidence_class",
    "freshness_label",
    "stale_warning",
    "allowed_use",
    "blocked_uses"
  ],
  "section_source_family_map": {
    "review_required_items": "any_family_where_review_required",
    "meeting_prep": ["meeting_prep_brief_sections"],
    "aging_watchlist": ["aging_exposure_report_items"],
    "risk_watchlist": ["project_risk_digest_items"],
    "recent_changes": ["cross_source_relationships", "project_issue_history_items"],
    "accepted_memory_context": ["accepted_long_term_memory"],
    "stale_or_low_confidence_warnings": "any_family_with_stale_flags_or_low_confidence"
  },
  "source_ref_policy": {
    "emit_raw_source_ref": false,
    "emit_source_ref_hash": true,
    "source_ref_label_safe_only": true
  },
  "forbidden_emitted_fields": [
    "raw_email_body",
    "raw_body",
    "raw_document_text",
    "raw_calendar_payload",
    "raw_procore_payload",
    "raw_prompt",
    "raw_response",
    "retrieved_context",
    "source_ref",
    "signed_url",
    "download_url",
    "graph_url",
    "token",
    "secret"
  ],
  "guardrails": {
    "advisory_only": true,
    "source_linked": true,
    "metadata_only": true,
    "no_raw": true,
    "no_writeback": true,
    "no_final_determinations": true,
    "claude_rendering_only": true
  },
  "rendering_instructions": [
    "Render as a human-readable executive brief.",
    "Preserve all warnings (stale, low-confidence, and review-required).",
    "Do not infer beyond the packet contents.",
    "Do not make final determinations (financial, legal, claim, payment, safety, schedule, contractual).",
    "Include the source coverage note.",
    "Include the suggested follow-up questions.",
    "Do not ask for raw records."
  ],
  "global_requirements": [
    "local_first",
    "fail_closed",
    "no_raw",
    "no_external_writeback",
    "advisory_only",
    "no_final_determination",
    "metadata_only",
    "read_only",
    "reuse_existing_daily_brief_logic",
    "no_retrieval_in_mcp"
  ]
}
