{
  "version": "phase_08b_automation_policy-v1",
  "purpose": "Declarative Phase 08B automation/observability policy substrate: health-check, retry, weekend, and alerting posture plus the structured reason-code vocabulary the future automation-hardening evaluator consumes. Declarative only — this prompt ships the policy + reason codes, not the execution.",
  "required_sections": ["health_checks", "retry", "weekend_behavior", "alerting", "reason_codes"],
  "alerting_channels_allowed": ["local_only"],
  "alerting_channels_forbidden": ["email", "slack", "teams", "sms", "push", "webhook", "graph_sendmail"],
  "reason_codes": [
    "HEALTH_CHECK_FAILED",
    "RETRY_EXHAUSTED",
    "WEEKEND_GATE_SKIPPED",
    "LAUNCHD_NOT_INSTALLED",
    "SCHEDULE_DRIFT",
    "RUN_OK",
    "RUN_DEGRADED",
    "LAUNCHD_INSTALLED_OK",
    "LAUNCHD_INSTALL_DISABLED_BY_POLICY",
    "CATCH_UP_NEEDED",
    "CATCH_UP_NOT_NEEDED",
    "CATCH_UP_STALE",
    "LOCK_ACQUIRED",
    "RUN_OVERLAP_BLOCKED",
    "STALE_LOCK_RECLAIMED",
    "LOCK_RELEASED",
    "LOCK_RELEASE_TOKEN_MISMATCH",
    "RUN_REGISTERED",
    "RUN_STEP_RECORDED",
    "RUN_REGISTRY_LOCKING_OK",
    "RETRY_SCHEDULED",
    "RETRY_SUCCEEDED",
    "RETRY_ATTEMPT_RECORDED",
    "RECOVERY_NEEDED",
    "RECOVERY_NOT_NEEDED",
    "RECOVERY_BLOCKED",
    "RUN_ORPHANED",
    "RUN_RECOVERED",
    "RETRY_RECOVERY_OK",
    "SOURCE_FRESH",
    "SOURCE_STALE",
    "SOURCE_FRESHNESS_UNKNOWN",
    "RETRIEVAL_FRESH",
    "RETRIEVAL_STALE",
    "RETRIEVAL_INDEX_MISSING",
    "RUNTIME_HEALTH_OK",
    "RUNTIME_HEALTH_DEGRADED",
    "OBSERVABILITY_OK",
    "OBSERVABILITY_DEGRADED"
  ],
  "guardrails": {
    "alerting_local_only": true,
    "no_external_delivery": true,
    "no_external_writeback": true,
    "dry_run_install_only": true
  }
}
