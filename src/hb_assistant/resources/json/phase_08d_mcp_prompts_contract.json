{
  "contract_name": "phase_08d_mcp_prompts_contract",
  "version": "1.4.0-phase-08d-planning",
  "prompts": [
    {
      "name": "review_today_brief",
      "routes_through": [
        "hb_get_daily_brief",
        "hb_validation_status"
