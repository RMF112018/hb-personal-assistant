    },
    {
      "name": "ask_project_question",
      "routes_through": [
        "hb_query",
        "hb_research_packet"
      ],
      "forbidden": "arbitrary SQL, direct APIs, unsupported conclusions"
    },
    {
      "name": "prepare_for_meeting",
      "routes_through": [
        "hb_research_packet",
        "hb_review_load_status",
        "hb_query"
      ],
