{
  "version": "phase_08b_data_quality_gates-v1",
  "purpose": "Phase 08B (Automation Delivery & Observability) substrate readiness gate set. Mirrors the Phase 08A gate report shape + status vocabulary. Readiness is never overstated: surfaces whose execution is owned by a later 08B prompt are deferred_not_blocking, never pass.",
  "required_fields": [
    "agent_run_receipt_persistence",
    "agent_model_receipt_persistence",
    "delivery_handoff_durability",
    "automation_policy_seed",
    "observability_reason_codes",
    "automation_health",
    "automation_execution",
    "launchd_install"
  ],
  "statuses": ["pass", "warning", "fail_blocking", "deferred_not_blocking"],
  "deferred_surfaces": ["automation_execution", "launchd_install"],
  "reason_codes": [
    "RECEIPT_PERSISTENCE_OK",
    "RECEIPT_TABLE_ABSENT",
    "DELIVERY_HANDOFF_DURABLE",
    "AUTOMATION_POLICY_SEED_INVALID",
    "OBSERVABILITY_REASON_CODES_PRESENT",
    "HEALTH_CHECK_FAILED",
    "RETRY_EXHAUSTED",
    "WEEKEND_GATE_SKIPPED",
    "LAUNCHD_NOT_INSTALLED",
    "SCHEDULE_DRIFT",
    "LAUNCHD_INSTALLED_OK",
    "LAUNCHD_INSTALL_DISABLED_BY_POLICY",
    "CATCH_UP_NEEDED",
    "CATCH_UP_NOT_NEEDED",
    "CATCH_UP_STALE",
    "LAUNCHD_SCHEDULING_OK",
    "HEALTH_RETRY_WEEKEND_ALERTING_EXECUTION_DEFERRED",
    "REAL_LAUNCHD_INSTALL_DEFERRED"
  ],
  "guardrails": {
    "external_systems": "read_only",
    "writeback": "none",
    "no_raw_content": true,
    "no_readiness_overstatement": true,
    "advisory_only": true
  }
}
