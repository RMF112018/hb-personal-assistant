    "RETRY_SUCCEEDED",
    "RETRY_ATTEMPT_RECORDED",
    "RECOVERY_NEEDED",
    "RECOVERY_NOT_NEEDED",
    "RECOVERY_BLOCKED",
    "RUN_ORPHANED",
    "RUN_RECOVERED",
