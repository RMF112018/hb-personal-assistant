{
  "version": "phase_08a_research_packet-v1",
  "purpose": "Bounded, redacted research packet assembled before any major synthesis; captures source coverage, conflicts, and context-quality assessment so synthesis degrades gracefully instead of overstating.",
  "required_fields": [
    "packet_id",
    "topic_hash",
    "source_ref_count",
    "review_required_count",
    "stale_unknown_count",
    "conflict_count",
    "context_quality_class",
    "degradation_mode",
    "confidence_class",
    "review_tier",
    "review_tier_reason_code",
    "review_status",
    "advisory_classification",
    "status"
  ],
  "context_quality_classes": [
    "sufficient",
    "partial",
    "insufficient"
  ],
  "degradation_modes": [
    "none",
    "graceful_degraded",
    "blocked"
  ],
  "advisory_classifications": [
    "advisory",
    "actionable"
  ],
  "guardrails": {
    "no_raw_content": true,
    "no_external_writeback": true,
    "source_references_required": true,
    "synthesis_requires_packet": true,
    "insufficient_context_must_degrade_not_overstate": true
  }
}
