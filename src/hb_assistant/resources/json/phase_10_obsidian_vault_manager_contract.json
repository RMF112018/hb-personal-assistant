{
  "schema": "phase_10_obsidian_vault_manager_contract",
  "version": "1.0.0",
  "allowed_write_modes": [
    "dry_run",
    "apply"
  ],
  "allowed_operations": [
    "index",
    "write_managed_section",
    "write_daily_brief",
    "suggest_tags"
  ],
  "path_policy": {
    "allowlisted_folders": [
      "Work/Daily-Brief",
      "Work/Projects",
      "Work/Actions",
      "Work/Meetings",
      "Work/AI-Outputs",
      "Work/MCP-Packets"
    ],
    "marker_bounded_writes_required": true,
    "frontmatter_merge_allowlist_required": true,
    "preserve_user_body": true
  },
  "guard_columns": [
    "raw_email_body_persisted",
    "raw_document_text_persisted",
    "raw_calendar_payload_persisted",
    "raw_procore_payload_persisted",
    "raw_prompt_persisted",
    "raw_response_persisted",
    "signed_url_persisted",
    "download_url_persisted",
    "external_writeback_performed",
    "graph_writeback_performed",
    "procore_writeback_performed",
    "email_send_performed",
    "calendar_mutation_performed"
  ]
}
