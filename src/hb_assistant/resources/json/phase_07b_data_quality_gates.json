    {
      "name": "email_thread_summary_population_status",
      "phase": "07B",
      "kind": "presence",
      "table": "email_thread_summaries",
      "description": "metadata-only email thread summaries materialized (V11)"
    },
    {
      "name": "meeting_email_candidate_population_status",
      "phase": "07B",
      "kind": "presence",
      "table": "meeting_email_relationship_candidates",
      "description": "calendar event to email thread relationship candidates generated (V23)"
