# HB Personal Assistant — NAS compose environment EXAMPLE (Phase N1B scaffold)
# Copy to deploy/nas/.env on the NAS and adjust. This EXAMPLE file holds NO secret VALUES —
# any real secret (e.g. the Cloudflare tunnel token) lives ONLY in the git-ignored deploy/nas/.env,
# never here and never in git.

# --- Host publish address (NEVER 0.0.0.0) ---
# Default is loopback (safest). Set to the NAS tailnet IP to reach it from the Mac over Tailscale,
# ONLY after the operator confirms firewall/router/Tailscale exposure is safe.
#   HB_PUBLISH_ADDR=127.0.0.1        # loopback only (default)
#   HB_PUBLISH_ADDR=<nas-tailnet-ip>     # NAS tailnet IP (Tailscale) — after exposure confirmed
HB_PUBLISH_ADDR=127.0.0.1

# --- Production-intent paths (defaults baked into compose.yaml) ---
# HB_CONFIG_FILE=/volume2/personal-assistant/config/hb-pa-config.yml
# HB_APP_SUPPORT_DIR=/volume2/personal-assistant/app-support

# --- N1C SCRATCH SMOKE overrides (uncomment for the disposable smoke; never a live DB) ---
# HB_CONFIG_FILE=/volume2/personal-assistant/config/hb-pa-config.smoke.yml
# HB_APP_SUPPORT_DIR=/volume2/personal-assistant/app-support-smoke

# NOTE: HB_PA_CONFIG and HB_EVIDENCE_DISABLE_BACKGROUND_WORKERS are set inside compose.yaml/Dockerfile
# and must NOT be weakened here.

# --- N8B Cloudflare Tunnel connector (deploy/nas/mcp/compose-cloudflared.yaml) ---
# The tunnel token is a SECRET. Put the real value ONLY in the git-ignored deploy/nas/.env
# (this .example is committed and must stay value-free). Create the tunnel + Access app first,
# and confirm Access denies unauthenticated traffic BEFORE starting the connector.
#   CLOUDFLARE_TUNNEL_TOKEN=            # REAL VALUE ONLY IN deploy/nas/.env — never here, never in git
# Pin the connector image and capture its resolved digest in evidence at deploy time:
#   CLOUDFLARED_IMAGE=cloudflare/cloudflared:2024.12.2   # verify tag exists; record `docker inspect` digest
